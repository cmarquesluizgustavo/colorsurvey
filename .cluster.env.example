# Copy to .cluster.env and fill in. Used by cluster/status.sh and cluster/fetch.sh,
# which run locally; the scripts that run on the cluster itself take their identity
# from the remote environment instead.

CLUSTER_HOST=            # ssh target (an alias from ~/.ssh/config works)
CLUSTER_USER=            # account jobs are submitted under
CLUSTER_PATH=colorsurvey # project root, relative to the home directory there
